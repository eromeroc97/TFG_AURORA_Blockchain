generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AUDITOR
  ADMIN
  GLOBAL_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum EcosystemStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String
  hashedRefreshToken String?
  role               Role       @default(USER)
  status             UserStatus @default(PENDING)
  isActive           Boolean    @default(true)

  // DID para no repudio: identidad humana para firmar/atribuir acciones en la red DLT.
  did String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ecosystems Ecosystem[]
}

model Ecosystem {
  id   String @id @default(uuid()) @db.Uuid
  name String

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  did                    String?         @unique
  certificateFingerprint String?         @unique
  status                 EcosystemStatus @default(PENDING)

  latitude  Float?
  longitude Float?

  // Estado en tiempo real (El histórico pertenece al microservicio de Auditoría)
  isOnline Boolean   @default(false)
  lastSeen DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]

  @@index([ownerId])
}

model Device {
  id String @id @default(uuid()) @db.Uuid

  ecosystemId String    @db.Uuid
  ecosystem   Ecosystem @relation(fields: [ecosystemId], references: [id], onDelete: Cascade)

  name        String
  fingerprint String       @unique
  status      DeviceStatus @default(PENDING)
  did         String?      @unique

  // Identidad Zero-Trust de la maquina: activa solo tras validacion y/o provisionado blockchain.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ecosystemId])
}
