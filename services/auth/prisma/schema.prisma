generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AUDITOR
  ADMIN
  GLOBAL_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  PASSBLOCK
  REVOKED
}

enum IdentityType {
  USER
  ECOSYSTEM
}

enum EcosystemStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum DeviceCategory {
  SMART_BULB
  SMART_PANEL
  SMART_PLUG
  ENERGY_METER
  CAMERA
  SMART_LOCK
  CONTACT_SENSOR
  MOTION_SENSOR
  THERMOSTAT
  HVAC
  SMART_SPEAKER
  SMART_TV
  APPLIANCE
  ROUTER
  OTHER
}

enum AccessRole {
  VIEWER
  EDITOR
}

model Identity {
  id String @id @default(uuid()) @db.Uuid
  type IdentityType

  publicKey String
  privateKeyCiphertext String @map("private_key_ciphertext")
  privateKeyIv String @map("private_key_iv")
  privateKeyAuthTag String @map("private_key_auth_tag")
  keyRotationTimestamp DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User?
  ecosystem Ecosystem?
}

model EcosystemAccess {
  id          String      @id @default(uuid()) @db.Uuid
  ecosystemId String      @db.Uuid
  userId      String      @db.Uuid
  role        AccessRole @default(VIEWER)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  ecosystem   Ecosystem   @relation(fields: [ecosystemId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ecosystemId, userId])
  @@index([ecosystemId])
  @@index([userId])
}

model User {
  id String @id @default(uuid()) @db.Uuid
  identityId String? @unique @db.Uuid
  identity Identity? @relation(fields: [identityId], references: [id])

  email String @unique
  passwordHash String
  passwordChangedAt DateTime @default(now())
  hashedRefreshToken String?
  role Role @default(USER)
  status UserStatus @default(PENDING)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ecosystems Ecosystem[]
  accesses   EcosystemAccess[]
  passwordResetTokens PasswordResetToken[]

  @@index([identityId])
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  tokenFingerprint String @unique
  createdAt DateTime @default(now())
  usedAt DateTime?

  @@index([userId])
  @@index([createdAt])
}

model Ecosystem {
  id String @id @default(uuid()) @db.Uuid
  identityId String @unique @db.Uuid
  identity Identity @relation(fields: [identityId], references: [id])

  name String

  ownerId String @db.Uuid
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  apiKey String? @map("api_key")
  apiKeyIv String? @map("api_key_iv")
  apiKeyAuthTag String? @map("api_key_auth_tag")
  status EcosystemStatus @default(PENDING)

  latitude Float?
  longitude Float?

  isOnline Boolean @default(false)
  lastSeen DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]
  accesses EcosystemAccess[]

  @@index([ownerId])
}

model Device {
  id String @id @default(uuid()) @db.Uuid

  ecosystemId String @db.Uuid
  ecosystem Ecosystem @relation(fields: [ecosystemId], references: [id], onDelete: Cascade)

  name String
  category DeviceCategory?
  room String?
  macAddress String? @db.VarChar(255)
  vendor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ecosystemId])
  @@unique([ecosystemId, macAddress])
}