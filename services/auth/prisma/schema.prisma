generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AUDITOR
  ADMIN
  GLOBAL_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  PASSBLOCK
  REVOKED
}

enum EcosystemStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String
  passwordChangedAt  DateTime   @default(now())
  hashedRefreshToken String?
  role               Role       @default(USER)
  status             UserStatus @default(PENDING)
  isActive           Boolean    @default(true)

  // DID para no repudio: identidad humana para firmar/atribuir acciones en la red DLT.
  did String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ecosystems Ecosystem[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String
  tokenFingerprint String   @unique
  createdAt        DateTime @default(now())
  usedAt           DateTime?

  @@index([userId])
  @@index([createdAt])
}

model Ecosystem {
  id   String @id @default(uuid()) @db.Uuid
  name String

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  did                    String?         @unique
  certificateFingerprint String?         @unique
  apiKey                 String?         @map("api_key")
  apiKeyIv               String?         @map("api_key_iv")
  apiKeyAuthTag          String?         @map("api_key_auth_tag")
  status                 EcosystemStatus @default(PENDING)

  latitude  Float?
  longitude Float?

  // Estado en tiempo real (El histórico pertenece al microservicio de Auditoría)
  isOnline Boolean   @default(false)
  lastSeen DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]

  @@index([ownerId])
}

model Device {
  id String @id @default(uuid()) @db.Uuid

  ecosystemId String    @db.Uuid
  ecosystem   Ecosystem @relation(fields: [ecosystemId], references: [id], onDelete: Cascade)

  name        String
  fingerprint String       @unique
  status      DeviceStatus @default(PENDING)
  did         String?      @unique

  // Identidad Zero-Trust de la maquina: activa solo tras validacion y/o provisionado blockchain.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ecosystemId])
}
