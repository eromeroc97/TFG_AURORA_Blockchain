    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.8",
    "@nestjs/swagger": "^8.1.0",
    "@prisma/adapter-pg": "^7.7.0",
