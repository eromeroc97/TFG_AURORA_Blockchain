<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Cambio de rol - AURORA</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;font-family:Arial,Helvetica,sans-serif;color:#222;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f4f4f4;padding:16px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:600px;max-width:600px;background:#ffffff;border:1px solid #dddddd;">
          <tr>
            <td style="padding:24px;">
              <h1 style="margin:0 0 16px 0;font-size:22px;line-height:1.3;color:#111111;">Tu rol fue actualizado</h1>
              <p style="margin:0 0 12px 0;font-size:15px;line-height:1.6;">Se aplicó un cambio en tus permisos de acceso.</p>
              {{#if previous_role}}
              <p style="margin:0 0 8px 0;font-size:15px;line-height:1.6;"><strong>Rol anterior:</strong> {{previous_role}}</p>
              {{/if}}
              <p style="margin:0 0 12px 0;font-size:15px;line-height:1.6;"><strong>Nuevo rol:</strong> {{new_role}}</p>
              <p style="margin:0;font-size:13px;line-height:1.6;color:#666666;">Si no reconoces este cambio, contacta con el soporte del sistema.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
