# ==========================================
# AURORA Auth Service - Environment Example
# ==========================================
# Copia este archivo como .env y completa los valores requeridos.

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Connection string para PostgreSQL
# Formato: postgresql://user:password@host:port/database?schema=schema
DATABASE_URL="postgresql://user:password@postgres-db:5432/database?schema=public"

# -----------------------------------------------------------------------------
# BLOCKCHAIN (Firefly)
# -----------------------------------------------------------------------------
# URL base de la API de Firefly para gestión de identidades en la blockchain
FIREFLY_API_URL=http://localhost:5000/api/v1/namespaces/default

# -----------------------------------------------------------------------------
# SMTP / MAIL
# -----------------------------------------------------------------------------
# Configuración del servidor SMTP para envío de correos electrónicos
# HOST: servidor SMTP (ej: mailpit, smtp.gmail.com)
# PORT: puerto SMTP (ej: 1025 para desarrollo, 587 para producción)
# USER/PASS: credenciales de autenticación (dejar vacío si no requiere auth)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# FRONTEND_URL: URL base del frontend para enlaces en correos (notificaciones, etc.)
# PASSWORD_RESET_ACTION_URL: URL base para enlaces de recuperación de contraseña
FRONTEND_URL=http://localhost
MAIL_FROM=noreply@aurora.es
PASSWORD_RESET_ACTION_URL=http://localhost/reset

# -----------------------------------------------------------------------------
# JWT (RS256)
# -----------------------------------------------------------------------------
# Claves RSA para firma y validación de tokens JWT
# Formato: PEM plano o PEM codificado en base64 en una línea
# IMPORTANTE: Nunca hagas commit de claves privadas reales
JWT_PRIVATE_KEY=<BASE64_OR_PEM_PRIVATE_KEY>
JWT_PUBLIC_KEY=<BASE64_OR_PEM_PUBLIC_KEY>

# Tiempos de expiración para los tokens
# Formatos válidos: números + unidad (s, m, h, d)
# JWT_ACCESS_EXPIRES_IN: token de acceso (recomendado: 5m-15m)
# JWT_REFRESH_EXPIRES_IN: token de refresh (recomendado: 7d-30d)
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=24h

# Política de cookie para refresh token
# DEVELOPMENT (valores por defecto):
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# PRODUCTION (valores recomendados):
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAMESITE=strict

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# Servidor Redis para cache distribuido y blacklist de tokens
# HOST: host del servidor Redis
# PORT: puerto del servidor Redis
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# HIBP (Have I Been Pwned)
# -----------------------------------------------------------------------------
# Verificación de contraseñas filtradas usando API k-anonymity
# DOCS: https://haveibeenpwned.com/API/v3#Passwords

# HIBP_PASSWORD_CHECK_ENABLED: habilitar verificación (true/false)
# HIBP_PWNED_PASSWORDS_BASE_URL: URL base de la API (no modificar)
# HIBP_TIMEOUT_MS: timeout para la petición en milisegundos
# HIBP_FAIL_CLOSED: true=fail-closed si no disponible, false=fail-open
HIBP_PASSWORD_CHECK_ENABLED=true
HIBP_PWNED_PASSWORDS_BASE_URL=https://api.pwnedpasswords.com/range
HIBP_TIMEOUT_MS=5000
HIBP_FAIL_CLOSED=false

# HIBP_API_KEY: clave API para endpoints autenticados (opcional)
# HIBP_USER_AGENT: User-Agent para peticiones (recomendado)
HIBP_API_KEY=
HIBP_USER_AGENT=AURORA-Auth-Service

# -----------------------------------------------------------------------------
# ECOSYSTEM API KEY ENCRYPTION
# -----------------------------------------------------------------------------
# Clave para cifrado de API keys de ecosistemas con AES-256-GCM
# GENERAR NUEVA CLAVE: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANTE: Mantener esta clave segura y consistente entre despliegues
API_KEY_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# CRYPTO MASTER KEY (Ed25519 Private Key Encryption)
# -----------------------------------------------------------------------------
# Clave maestra de 32 bytes (256 bits) para cifrar claves privadas Ed25519 con AES-256-GCM
# GENERAR NUEVA CLAVE: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANTE: Mantener esta clave segura y consistente entre despliegues
# Esta clave NUNCA debe almacenarse junto con los datos cifrados
CRYPTO_MASTER_KEY=

# -----------------------------------------------------------------------------
# RUNTIME / TEST
# -----------------------------------------------------------------------------
# NODE_ENV: entorno de ejecución (development/test/production)
# TEST_OWNER_ID: ID de usuario para tests (no usar en producción)
NODE_ENV=development
TEST_OWNER_ID=1

# AUTH_INTERNAL_TOKEN: token para endpoints internos del IoT
# IMPORTANTE: Usar un token largo y aleatorio en producción
AUTH_INTERNAL_TOKEN=

# -----------------------------------------------------------------------------
# LOGGING (Seq)
# -----------------------------------------------------------------------------
# Configuración de logs centralizados con Seq
# DOCS: https://datalust.co/

# SEQ_URL: URL del servidor Seq
# SEQ_API_KEY_AUTH: clave API para ingestión de logs (Write/Ingest only)
# ENABLE_SEQ_LOGGING: habilitar logging a Seq (true/false)
# SEQ_FIRSTRUN_ADMINUSERNAME/ADMINPASSWORD: credenciales primer acceso
SEQ_URL=http://seq:5341
SEQ_API_KEY_AUTH=
ENABLE_SEQ_LOGGING=false
SEQ_FIRSTRUN_ADMINUSERNAME=
SEQ_FIRSTRUN_ADMINPASSWORD=

# Alternativa si auth corre fuera de Docker Compose:
# SEQ_URL=http://localhost:5341