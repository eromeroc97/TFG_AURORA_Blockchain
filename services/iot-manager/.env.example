# ==========================================
# AURORA IoT Manager - Environment Example
# ==========================================
# Copia este archivo como .env y completa los valores requeridos.

# -----------------------------------------------------------------------------
# RUNTIME / SERVER
# -----------------------------------------------------------------------------
# Puerto donde escucha el servicio
# Default: 3002
PORT=3002

# Entorno de ejecución
# Valores válidos: development, test, production
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE (MongoDB)
# -----------------------------------------------------------------------------
# Connection string para MongoDB
# Format: mongodb://user:password@host:port/database?authSource=source
MONGO_URI=

# -----------------------------------------------------------------------------
# BLOCKCHAIN (Firefly)
# -----------------------------------------------------------------------------
# URL base de la API de Firefly para gestión de identidades
FIREFLY_API_URL=

# -----------------------------------------------------------------------------
# REDIS (API Key Cache)
# -----------------------------------------------------------------------------
# URL de conexión a Redis para cache de API keys válidas
# Formato: redis://host:port o redis://password@host:port
REDIS_URL=

# -----------------------------------------------------------------------------
# MAC VENDOR LOOKUP
# -----------------------------------------------------------------------------
# URL base de la API para resolución de vendor por MAC
# Docs: https://macvendors.com/
# Default: https://api.macvendors.com
MAC_VENDOR_API_BASE_URL=https://api.macvendors.com

# -----------------------------------------------------------------------------
# MICROSERVICES INTER-COMMUNICATION (East-West)
# -----------------------------------------------------------------------------
# Endpoints del auth-service para validación y gestión de dispositivos
# IMPORTANTE: Estos endpoints deben estar habilitados en auth-service
AUTH_VALIDATE_API_KEY_URL=
AUTH_DEVICE_LOOKUP_URL=
AUTH_DEVICE_REGISTER_URL=
AUTH_DEVICE_UPDATE_VENDOR_URL=
AUTH_SIGN_URL=

# Token compartido para llamadas internas cross-service
# IMPORTANTE: Debe coincidir con AUTH_INTERNAL_TOKEN en auth-service
AUTH_INTERNAL_TOKEN=

# -----------------------------------------------------------------------------
# API KEY CACHE (TTL)
# -----------------------------------------------------------------------------
# Tiempos de vida para cache de API keys (en milisegundos)
# positivo: cuando la key es válid a (recomendado: 5-15 min)
# negativo: cuando la key es inválida (recomendado: 15-30 seg)
IOT_API_KEY_POSITIVE_TTL_MS=600000
IOT_API_KEY_NEGATIVE_TTL_MS=15000

# -----------------------------------------------------------------------------
# API KEY STATIC MAP (Testing/Development)
# -----------------------------------------------------------------------------
# Mapeo estático de API keys a ecosistemas (formato JSON)
# Útil para testing sin depender del auth-service
#
# Formato simple (solo ecosystemId):
#   {"AUR-abc123": "eco-001"}
#
# Formato completo (con ecosystemId y did):
#   {"AUR-abc123": {"ecosystemId": "eco-001", "did": "did:firefly:custom/eco-001"}}
#
# Ejemplo completo:
#   IOT_API_KEY_STATIC_MAP={"AUR-test123":{"ecosystemId":"eco-test-001","did":"did:firefly:custom/eco-test-001"}}
IOT_API_KEY_STATIC_MAP=

# -----------------------------------------------------------------------------
# LOGGING (Seq)
# -----------------------------------------------------------------------------
# Configuración de logs centralizados con Seq
# Docs: https://datalust.co/

# SEQ_URL: URL del servidor Seq
SEQ_URL=http://seq:5341

# SEQ_API_KEY_IOT: clave API para ingestión de logs (Write/Ingest only)
SEQ_API_KEY_IOT=

# ENABLE_SEQ_LOGGING: habilitar logging a Seq (true/false)
ENABLE_SEQ_LOGGING=false

# SEQ_FIRSTRUN_ADMINUSERNAME/ADMINPASSWORD: credenciales primer acceso
SEQ_FIRSTRUN_ADMINUSERNAME=
SEQ_FIRSTRUN_ADMINPASSWORD=

# Alternativa si iot-manager corre fuera de Docker Compose:
# SEQ_URL=http://localhost:5341
# REDIS_URL=redis://localhost:6379