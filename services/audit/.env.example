# ==========================================
# AURORA Audit Service - Environment Example
# ==========================================
# Copia este archivo como .env y completa los valores requeridos.

# -----------------------------------------------------------------------------
# RUNTIME / SERVER
# -----------------------------------------------------------------------------
# Puerto donde escucha el servicio
# Default: 3003
PORT=3003

# Entorno de ejecución
# Valores válidos: development, test, production
NODE_ENV=development

# -----------------------------------------------------------------------------
# BLOCKCHAIN (FireFly)
# -----------------------------------------------------------------------------
# URL base de la API de FireFly (ej. http://localhost:5000)
FIREFLY_API_URL=http://localhost:5000

# ID del contrato (chaincode) desplegado en FireFly
# Obtener tras ejecutar: ff get contracts --namespace default
FIREFLY_CONTRACT_ID=

# Namespace de FireFly (por defecto: default)
FIREFLY_NAMESPACE=default

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
# Clave pública JWT para validar tokens de auditoría
# Formato PEM (puede estar en variable multilínea usando \n)
# Ejemplo: -----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----
JWT_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# TIMELINE CONFIGURATION
# -----------------------------------------------------------------------------
# Límite por defecto para consultas de timeline
TIMELINE_DEFAULT_LIMIT=50

# Límite máximo permitido para timeline
TIMELINE_MAX_LIMIT=500

# -----------------------------------------------------------------------------
# CACHE (Opcional)
# -----------------------------------------------------------------------------
# URL de conexión a Redis para caché de estadísticas frecuentes
# Formato: redis://host:port o redis://password@host:port
# REDIS_URL=redis://redis-audit:6380

# TTL para caché de estadísticas (en milisegundos)
# Default: 5 minutos
STATS_CACHE_TTL_MS=300000

# -----------------------------------------------------------------------------
# LOGGING (Seq - Opcional)
# -----------------------------------------------------------------------------
# Configuración de logs centralizados con Seq
# Docs: https://datalust.co/

# SEQ_URL: URL del servidor Seq
# SEQ_URL=http://seq:5341

# SEQ_API_KEY_AUDIT: clave API para ingestión de logs (Write/Ingest only)
# SEQ_API_KEY_AUDIT=

# ENABLE_SEQ_LOGGING: habilitar logging a Seq (true/false)
# ENABLE_SEQ_LOGGING=false

# SEQ_FIRSTRUN_ADMINUSERNAME/ADMINPASSWORD: credenciales primer acceso
# SEQ_FIRSTRUN_ADMINUSERNAME=
# SEQ_FIRSTRUN_ADMINPASSWORD=

# Alternativa si audit corre fuera de Docker Compose:
# SEQ_URL=http://localhost:5341
# REDIS_URL=redis://localhost:6379
