# FireFly API Configuration
# Base URL for the FireFly API (include /api path)
FIREFLY_API_URL=http://firefly:5000/api

# JWT Configuration for authorization
# Only GLOBAL_ADMIN role can access this service
# Paste the public key (PEM format) for JWT verification
JWT_PUBLIC_KEY=your_jwt_public_key_here

# Service Configuration
# Internal port for the blockchain-manager service
BLOCKCHAIN_MANAGER_PORT=3004