# ==========================================
# AURORA WebApp - Environment Example
# ==========================================
# Copia este archivo como .env y completa los valores requeridos.

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Path base para todas las llamadas API (usado en axios)
# Default: /api ( funciona con el proxy de Vite en desarrollo)
VITE_API_BASE_PATH=/api

# Target del proxy en desarrollo
# Apunta al API Gateway o directamente al auth-service
# Ejemplos:
#   - http://localhost (si hay gateway)
#   - http://localhost:3001 (auth-service directo)
#   - http://host.docker.internal:3001 (desde Docker)
VITE_DEV_API_GATEWAY_TARGET=http://localhost

# Health checks para el dashboard
# Deben apuntar a cada servicio a través del proxy Traefik en localhost.
VITE_FIREFLY_HEALTH_URL=http://localhost/api/firefly/health
VITE_THREAD_INTELLIGENCE_HEALTH_URL=http://localhost/api/thread-intelligence/health
VITE_IOT_MANAGER_HEALTH_URL=http://localhost/api/telemetry/health
VITE_AUTH_HEALTH_URL=http://localhost/api/auth/health
